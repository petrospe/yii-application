{
    "name": "sxoli/cms",
    "description": "Sxoli CMS, a WordPress-style content manager on Yii 2.",
    "type": "project",
    "license": "BSD-3-Clause",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "sxoli/cms-admin": "^1.0",
        "sxoli/cms-core": "^1.0",
        "sxoli/cms-theme": "^1.0",
        "sxoli/plugin-hello": "^1.0",
        "yiisoft/yii2": "~2.0.55",
        "yiisoft/yii2-bootstrap5": "~2.0.4",
        "yiisoft/yii2-symfonymailer": "~3.0.0"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "~2.1.0",
        "yiisoft/yii2-gii": "~2.2.0"
    },
    "autoload": {
        "psr-4": {
            "common\\": "common/",
            "frontend\\": "frontend/",
            "backend\\": "backend/",
            "console\\": "console/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/plugins/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "process-timeout": 1800,
        "sort-packages": true,
        "fxp-asset": {
            "enabled": false
        }
    },
    "scripts": {
        "cms-install": [
            "php yii cms/install"
        ]
    }
}
